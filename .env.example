# Copia este archivo a .env y rellena los valores.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# IA · Google AI Studio → Get API key
GEMINI_API_KEY=
# Opcional: por defecto gemini-flash-latest
GEMINI_MODEL=

# MCP para Claude y cron: credenciales de tu usuario de root
ROOT_EMAIL=
ROOT_PASSWORD=
# Secreto largo y aleatorio: la URL del conector será /api/mcp/<MCP_SECRET>
MCP_SECRET=
# Lo envía Vercel Cron en la cabecera Authorization
CRON_SECRET=

# Notificaciones push · npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
